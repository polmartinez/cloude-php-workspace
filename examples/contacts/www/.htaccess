# Apache front-controller rules. The same routing works on:
#   - php -S      → handled in code by Cloude\Bootstrap::serveStaticIfExists
#   - nginx       → see ./nginx.conf.example
#   - Caddy       → `try_files {path} index.php` in a Caddyfile site block
#
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass static assets (existing files / directories) straight through.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>
