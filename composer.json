{
    "name": "cloude/framework",
    "description": "Minimalist PHP 8.3+ micro-framework: router, input, views, markdown and string helpers. No magic, no database, no container. Designed for small and medium web projects running on Apache.",
    "type": "library",
    "keywords": ["php", "framework", "router", "micro-framework", "cloude", "psr-4", "psr-12"],
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "erusev/parsedown": "^1.7",
        "jbroadway/urlify": "dev-master",
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "suggest": {
        "erusev/parsedown": "Required to use Cloude\\Markdown.",
        "jbroadway/urlify": "Improves slug transliteration in Cloude\\Str::slug() (an iconv-based fallback is used when missing)."
    },
    "autoload": {
        "psr-4": {
            "Cloude\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cloude\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
